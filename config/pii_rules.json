{
  "version": "1.0.0",
  "description": "Enterprise Extensible PII and Sensitive Data Detection Rules",
  "custom_patterns": [
    {
      "name": "International Bank Account Number (IBAN)",
      "category": "BANK_ACCOUNT",
      "regex": "\\b[A-Z]{2}\\d{2}[A-Z0-9]{4}\\d{7}([A-Z0-9]?){0,16}\\b",
      "confidence": 0.90,
      "mask_replacement": "[REDACTED_IBAN]"
    },
    {
      "name": "US Social Security Number (SSN)",
      "category": "GOV_ID",
      "regex": "\\b(?!000|666|9\\d{2})\\d{3}-(?!00)\\d{2}-(?!0000)\\d{4}\\b",
      "confidence": 0.95,
      "mask_replacement": "***-**-****"
    },
    {
      "name": "Generic Corporate API Secret Key Pattern",
      "category": "SECRET_KEY",
      "regex": "(?i)(?:api_secret|client_secret|app_secret|secret_token)\\s*[:=]\\s*['\"]([a-zA-Z0-9_\\-]{24,})['\"]",
      "confidence": 0.92,
      "mask_replacement": "[REDACTED_CORPORATE_SECRET]"
    }
  ]
}
